---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

const team = [
  {
    name: "Alejandro Mendoza",
    role: "Director General",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80",
  },
  {
    name: "Carmen Rodríguez",
    role: "Asesora Senior",
    image: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80",
  },
  {
    name: "Luis Fernández",
    role: "Asesor Legal",
    image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&q=80",
  },
];
---

<Layout>
  <Nav />
  <main>
    <section class="bg-cream pt-32 pb-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-sm text-ink-muted tracking-widest uppercase mb-4 reveal">Nosotros</p>
        <h1 class="font-display text-4xl md:text-6xl font-bold text-ink tracking-tight mb-6 reveal">
          Más que una inmobiliaria
        </h1>
        <p class="text-ink-muted text-xl leading-relaxed reveal">
          Conectamos familias con hogares desde 2010. Nuestra misión es hacer del proceso de compra una experiencia transparente, personalizada y sin sorpresas.
        </p>
      </div>
    </section>

    <section class="bg-sand">
      <div class="max-w-7xl mx-auto px-6 py-24 md:py-32">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
          <div class="reveal">
            <span class="font-display text-6xl md:text-7xl font-bold text-forest/20 tabular-nums block mb-4">15</span>
            <h3 class="font-display text-xl font-bold text-ink mb-2">Años de experiencia</h3>
            <p class="text-ink-muted leading-relaxed">
              Desde 2010 acompañando a familias en la compra de su hogar en Venezuela.
            </p>
          </div>

          <div class="reveal">
            <span class="font-display text-6xl md:text-7xl font-bold text-forest/20 tabular-nums block mb-4">250+</span>
            <h3 class="font-display text-xl font-bold text-ink mb-2">Propiedades vendidas</h3>
            <p class="text-ink-muted leading-relaxed">
              Casas, apartamentos y terrenos que encontraron a sus nuevas familias.
            </p>
          </div>

          <div class="reveal">
            <span class="font-display text-6xl md:text-7xl font-bold text-forest/20 tabular-nums block mb-4">98%</span>
            <h3 class="font-display text-xl font-bold text-ink mb-2">Clientes satisfechos</h3>
            <p class="text-ink-muted leading-relaxed">
              La recomendación de nuestros clientes es nuestro mejor testimonio.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-cream">
      <div class="max-w-7xl mx-auto px-6 py-24 md:py-32">
        <div class="text-center mb-16 reveal">
          <p class="text-sm text-ink-muted tracking-widest uppercase mb-4">Nuestro equipo</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold text-ink tracking-tight">
            Profesionales a tu servicio
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {team.map((member) => (
            <article class="reveal">
              <div class="aspect-square rounded-2xl overflow-hidden bg-sand mb-6">
                <Image
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover"
                  width="400"
                  height="400"
                />
              </div>
              <h3 class="font-display text-xl font-bold text-ink mb-1">{member.name}</h3>
              <p class="text-forest text-sm font-medium">{member.role}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-forest">
      <div class="max-w-4xl mx-auto px-6 py-24 md:py-32 text-center">
        <h2 class="font-display text-3xl md:text-5xl font-bold text-cream tracking-tight mb-6 reveal">
          Nuestros valores
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
          <div class="reveal">
            <h3 class="text-cream font-bold text-lg mb-2">Transparencia</h3>
            <p class="text-cream/80">
              Información clara desde el primer momento. Sin costos ocultos, sin sorpresas.
            </p>
          </div>
          <div class="reveal">
            <h3 class="text-cream font-bold text-lg mb-2">Personalización</h3>
            <p class="text-cream/80">
              Cada cliente es único. Adaptamos nuestro servicio a tus necesidades específicas.
            </p>
          </div>
          <div class="reveal">
            <h3 class="text-cream font-bold text-lg mb-2">Compromiso</h3>
            <p class="text-cream/80">
              Estamos contigo hasta la entrega de llaves. Tu satisfacción es nuestra prioridad.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
