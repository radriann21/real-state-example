---
import { Image } from "astro:assets";

const features = [
    {
        title: "Espacios que respiran",
        description:
            "Cada propiedad cuenta con ventilación cruzada, luz natural y áreas verdes integradas al diseño arquitectónico.",
        image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80",
        items: ["Ventilación natural", "Luz todo el día", "Jardines privados"],
    },
    {
        title: "Vecindarios con historia",
        description:
            "Zonas consolidadas de Caracas, Valencia y Lechería con acceso a servicios, gastronomía y vida cultural.",
        image: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=800&q=80",
        items: ["Servicios cercanos", "Vida cultural", "Seguridad 24/7"],
    },
    {
        title: "Inversión que crece",
        description:
            "Propiedades en zonas de alta demanda con plusvalía comprobada y potencial de rentabilidad a corto plazo.",
        image: "https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=800&q=80",
        items: ["Plusvalía anual", "Alta demanda", "ROI comprobado"],
    },
];
---

<section class="bg-cream">
    <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 space-y-24 md:space-y-32">
        {
            features.map((feature, i) => (
                <div
                    class={`flex flex-col ${i % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"} gap-12 md:gap-16 items-center`}
                >
                    <div class="flex-1 min-w-0 reveal">
                        <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-sand group">
            <Image
              src={feature.image}
              alt={feature.title}
              class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.02]"
              loading="lazy"
              width="800"
              height="600"
            />
                        </div>
                    </div>

                    <div class="flex-1 min-w-0 reveal">
                        <h3 class="font-display text-2xl md:text-3xl font-bold text-ink tracking-tight mb-4">
                            {feature.title}
                        </h3>
                        <p class="text-ink-muted text-xl leading-relaxed mb-8">
                            {feature.description}
                        </p>
                        <ul class="space-y-3">
                            {feature.items.map((item) => (
                                <li class="flex items-center gap-3 text-ink">
                                    <span class="w-2 h-2 rounded-full bg-forest flex-shrink-0" />
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            ))
        }
    </div>
</section>
