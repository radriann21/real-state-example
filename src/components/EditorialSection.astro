---
const sections = [
  {
    number: '01',
    title: 'Selección curada',
    description: 'Cada propiedad pasa por un proceso riguroso de evaluación: ubicación, estado estructural, potencial de valorización y calidad de vida del entorno. Solo el 12% de las propiedades que evaluamos llegan a nuestro portafolio.',
  },
  {
    number: '02',
    title: 'Acompañamiento integral',
    description: 'Desde la primera visita hasta la firma notarial, te guiamos en cada paso. Asesoría legal, evaluación financiera, negociación con vendedores y gestión documental — todo incluido, sin costos ocultos.',
  },
  {
    number: '03',
    title: 'Red local consolidada',
    description: 'Más de 15 años conectando compradores con las mejores propiedades de Venezuela. Conocemos cada zona, cada vecindario y cada oportunidad antes de que llegue al mercado abierto.',
  },
];
---

<section class="bg-sand">
  <div class="max-w-7xl mx-auto px-6 py-24 md:py-32">
    <div class="text-center mb-20 reveal">
      <p class="text-sm text-ink-muted tracking-widest uppercase mb-4">Por qué TerraNativa</p>
      <h2 class="font-display text-3xl md:text-5xl font-bold text-ink tracking-tight">
        Un proceso diseñado para ti
      </h2>
    </div>

    <div class="space-y-24 md:space-y-32">
      {sections.map((section) => (
        <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-start reveal">
          <div class="md:w-1/3">
            <span class="font-display text-[120px] md:text-[160px] font-bold text-forest/10 leading-none tabular-nums">
              {section.number}
            </span>
          </div>
          <div class="md:w-2/3 md:pt-8">
            <h3 class="font-display text-2xl md:text-3xl font-bold text-ink tracking-tight mb-4">
              {section.title}
            </h3>
            <p class="text-ink-muted text-xl leading-relaxed">
              {section.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
