---
const zones = ['Caracas', 'Valencia', 'Margarita', 'Mérida', 'Lechería'];
---

<section class="bg-sand border-y border-ink/5">
  <div class="max-w-7xl mx-auto px-6 py-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
    {zones.map((z, i) => (
      <>
        {i > 0 && <span class="w-1 h-1 rounded-full bg-ink-muted/30 hidden sm:block" />}
        <span class="text-sm text-ink-muted tracking-wide">{z}</span>
      </>
    ))}
  </div>
</section>
